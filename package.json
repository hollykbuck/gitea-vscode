{
    "name": "limeclient",
    "displayName": "LimeClient",
    "description": "Community Gitea client for VS Code (unofficial, not affiliated with Gitea)",
    "version": "0.2.2",
    "publisher": "hollykbuck",
    "license": "GPL-3.0-only",
    "repository": {
        "url": "https://github.com/hollykbuck/gitea-vscode"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "SCM Providers"
    ],
    "activationEvents": [
        "onView:limeclient.repositories",
        "onView:limeclient.issues",
        "onView:limeclient.pullRequests",
        "onView:limeclient.deletedBranches",
        "onView:limeclient.actions",
        "onView:limeclient.actionsSettings",
        "onAuthenticationRequest:limeclient"
    ],
    "main": "./dist/extension.js",
    "icon": "media/limeclient-logo.png",
    "contributes": {
        "commands": [
            {
                "command": "limeclient.configure",
                "title": "LimeClient: Configure Instance",
                "icon": "$(gear)"
            },
            {
                "command": "limeclient.signInWithOAuth",
                "title": "LimeClient: Sign in with OAuth (Browser)",
                "icon": "$(account)"
            },
            {
                "command": "limeclient.signInWithGitCredential",
                "title": "LimeClient: Sign in with Git Credential",
                "icon": "$(key)"
            },
            {
                "command": "limeclient.actions.refresh",
                "title": "Refresh Actions",
                "icon": "$(refresh)"
            },
            {
                "command": "limeclient.actions.openRunInBrowser",
                "title": "Open Run in Browser",
                "icon": "$(globe)"
            },
            {
                "command": "limeclient.actions.rerunRun",
                "title": "Rerun Workflow Run",
                "icon": "$(run-all)"
            },
            {
                "command": "limeclient.actions.rerunFailedJobs",
                "title": "Rerun Failed Jobs",
                "icon": "$(debug-restart)"
            },
            {
                "command": "limeclient.actions.viewJobLogs",
                "title": "View Job Logs",
                "icon": "$(output)"
            },
            {
                "command": "limeclient.actions.viewRunLogs",
                "title": "View Run Logs",
                "icon": "$(output)"
            },
            {
                "command": "limeclient.actions.downloadArtifacts",
                "title": "Download Artifacts",
                "icon": "$(download)"
            },
            {
                "command": "limeclient.actions.addSecret",
                "title": "Add Secret",
                "icon": "$(key)"
            },
            {
                "command": "limeclient.actions.deleteSecret",
                "title": "Delete Secret",
                "icon": "$(trash)"
            },
            {
                "command": "limeclient.actions.updateSecret",
                "title": "Update Secret",
                "icon": "$(edit)"
            },
            {
                "command": "limeclient.actions.addVariable",
                "title": "Add Variable",
                "icon": "$(add)"
            },
            {
                "command": "limeclient.actions.updateVariable",
                "title": "Update Variable",
                "icon": "$(edit)"
            },
            {
                "command": "limeclient.actions.deleteVariable",
                "title": "Delete Variable",
                "icon": "$(trash)"
            },
            {
                "command": "limeclient.searchRepositories",
                "title": "LimeClient: Search Repositories",
                "icon": "$(search)"
            },
            {
                "command": "limeclient.searchIssues",
                "title": "LimeClient: Search Issues",
                "icon": "$(search)"
            },
            {
                "command": "limeclient.searchPullRequests",
                "title": "LimeClient: Search Pull Requests",
                "icon": "$(search)"
            },
            {
                "command": "limeclient.refreshRepositories",
                "title": "Refresh Repositories",
                "icon": "$(refresh)"
            },
            {
                "command": "limeclient.toggleNotifications",
                "title": "LimeClient: Toggle Notifications",
                "icon": "$(bell)"
            },
            {
                "command": "limeclient.notificationStatus",
                "title": "LimeClient: Check Notification Status",
                "icon": "$(info)"
            },
            {
                "command": "limeclient.createRepository",
                "title": "LimeClient: Create Repository",
                "icon": "$(new-folder)"
            },
            {
                "command": "limeclient.createIssue",
                "title": "LimeClient: Create Issue",
                "icon": "$(new-file)"
            },
            {
                "command": "limeclient.createPullRequest",
                "title": "LimeClient: Create Pull Request",
                "icon": "$(git-pull-request-create)"
            },
            {
                "command": "limeclient.openRepository",
                "title": "Open Repository in VS Code",
                "icon": "$(folder-opened)"
            },
            {
                "command": "limeclient.openInBrowser",
                "title": "Open in Browser",
                "icon": "$(globe)"
            },
            {
                "command": "limeclient.openIssueInBrowser",
                "title": "Open Issue in Browser",
                "icon": "$(globe)"
            },
            {
                "command": "limeclient.openPullRequestInBrowser",
                "title": "Open Pull Request in Browser",
                "icon": "$(globe)"
            },
            {
                "command": "limeclient.viewIssueDetails",
                "title": "View Issue Details",
                "icon": "$(eye)"
            },
            {
                "command": "limeclient.viewPullRequestDetails",
                "title": "View Pull Request Details",
                "icon": "$(eye)"
            },
            {
                "command": "limeclient.switchBranch",
                "title": "LimeClient: Switch Branch",
                "icon": "$(git-branch)"
            },
            {
                "command": "limeclient.createBranchFromIssue",
                "title": "LimeClient: Create Branch from Issue",
                "icon": "$(git-branch)"
            },
            {
                "command": "limeclient.createBranchFromPR",
                "title": "LimeClient: Create Branch from Pull Request",
                "icon": "$(git-branch)"
            },
            {
                "command": "limeclient.deleteBranch",
                "title": "LimeClient: Delete Branch",
                "icon": "$(trash)"
            },
            {
                "command": "limeclient.restoreDeletedBranch",
                "title": "LimeClient: Restore Deleted Branch",
                "icon": "$(discard)"
            },
            {
                "command": "limeclient.restoreBranchFromReflog",
                "title": "LimeClient: Restore Branch from Reflog",
                "icon": "$(history)"
            },
            {
                "command": "limeclient.showDeletedBranchDetails",
                "title": "Show Deleted Branch Details",
                "icon": "$(info)"
            },
            {
                "command": "limeclient.restoreBranchFromTree",
                "title": "Restore Branch",
                "icon": "$(discard)"
            },
            {
                "command": "limeclient.removeFromHistory",
                "title": "Remove from History",
                "icon": "$(trash)"
            },
            {
                "command": "limeclient.clearDeletionHistory",
                "title": "Clear All Deletion History",
                "icon": "$(clear-all)"
            },
            {
                "command": "limeclient.exportDeletionHistory",
                "title": "LimeClient: Export Deletion History",
                "icon": "$(export)"
            },
            {
                "command": "limeclient.importDeletionHistory",
                "title": "LimeClient: Import Deletion History",
                "icon": "$(import)"
            },
            {
                "command": "limeclient.refreshDeletedBranches",
                "title": "Refresh Deleted Branches",
                "icon": "$(refresh)"
            },
            {
                "command": "limeclient.addProfile",
                "title": "LimeClient: Add Profile",
                "icon": "$(add)"
            },
            {
                "command": "limeclient.manageStash",
                "title": "LimeClient: Manage Stashes",
                "icon": "$(archive)"
            },
            {
                "command": "limeclient.switchProfile",
                "title": "LimeClient: Switch Profile",
                "icon": "$(account)"
            },
            {
                "command": "limeclient.removeProfile",
                "title": "LimeClient: Remove Profile",
                "icon": "$(trash)"
            },
            {
                "command": "limeclient.showVersionInfo",
                "title": "LimeClient: Show Version Info",
                "icon": "$(versions)"
            },
            {
                "command": "limeclient.syncProfileToGitea",
                "title": "LimeClient: Sync VS Code Profile to Gitea",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "limeclient.restoreProfileFromGitea",
                "title": "LimeClient: Restore VS Code Profile from Gitea",
                "icon": "$(cloud-download)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "limeclient-explorer",
                    "title": "LimeClient",
                    "icon": "media/limeclient-activity.svg"
                },
                {
                    "id": "limeclient-actions",
                    "title": "LimeClient Actions",
                    "icon": "media/limeclient-actions.svg"
                }
            ]
        },
        "views": {
            "limeclient-explorer": [
                {
                    "id": "limeclient.repositories",
                    "name": "Repositories",
                    "icon": "$(git-branch)"
                },
                {
                    "id": "limeclient.issues",
                    "name": "Issues",
                    "icon": "$(issue-opened)"
                },
                {
                    "id": "limeclient.pullRequests",
                    "name": "Pull Requests",
                    "icon": "$(git-pull-request)"
                },
                {
                    "id": "limeclient.deletedBranches",
                    "name": "Deleted Branches",
                    "icon": "$(trash)"
                }
            ],
            "limeclient-actions": [
                {
                    "id": "limeclient.actions",
                    "name": "Workflow Runs",
                    "icon": "$(play)"
                },
                {
                    "id": "limeclient.actionsSettings",
                    "name": "Settings",
                    "icon": "$(gear)"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "limeclient.refreshRepositories",
                    "when": "view == limeclient.repositories || view == limeclient.issues || view == limeclient.pullRequests",
                    "group": "navigation"
                },
                {
                    "command": "limeclient.searchRepositories",
                    "when": "view == limeclient.repositories",
                    "group": "navigation"
                },
                {
                    "command": "limeclient.searchIssues",
                    "when": "view == limeclient.issues",
                    "group": "navigation"
                },
                {
                    "command": "limeclient.searchPullRequests",
                    "when": "view == limeclient.pullRequests",
                    "group": "navigation"
                },
                {
                    "command": "limeclient.createRepository",
                    "when": "view == limeclient.repositories",
                    "group": "navigation@2"
                },
                {
                    "command": "limeclient.createIssue",
                    "when": "view == limeclient.issues",
                    "group": "navigation@2"
                },
                {
                    "command": "limeclient.createPullRequest",
                    "when": "view == limeclient.pullRequests",
                    "group": "navigation@2"
                },
                {
                    "command": "limeclient.refreshDeletedBranches",
                    "when": "view == limeclient.deletedBranches",
                    "group": "navigation"
                },
                {
                    "command": "limeclient.restoreBranchFromReflog",
                    "when": "view == limeclient.deletedBranches",
                    "group": "navigation@2"
                },
                {
                    "command": "limeclient.clearDeletionHistory",
                    "when": "view == limeclient.deletedBranches",
                    "group": "navigation@3"
                },
                {
                    "command": "limeclient.exportDeletionHistory",
                    "when": "view == limeclient.deletedBranches",
                    "group": "1_export"
                },
                {
                    "command": "limeclient.importDeletionHistory",
                    "when": "view == limeclient.deletedBranches",
                    "group": "1_export"
                },
                {
                    "command": "limeclient.actions.refresh",
                    "when": "view == limeclient.actions || view == limeclient.actionsSettings",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "limeclient.actions.openRunInBrowser",
                    "when": "view == limeclient.actions && viewItem == actionRun",
                    "group": "inline"
                },
                {
                    "command": "limeclient.actions.rerunRun",
                    "when": "view == limeclient.actions && viewItem == actionRun",
                    "group": "1_actions"
                },
                {
                    "command": "limeclient.actions.rerunFailedJobs",
                    "when": "view == limeclient.actions && viewItem == actionRun",
                    "group": "1_actions"
                },
                {
                    "command": "limeclient.actions.downloadArtifacts",
                    "when": "view == limeclient.actions && viewItem == actionRun",
                    "group": "1_actions"
                },
                {
                    "command": "limeclient.actions.viewJobLogs",
                    "when": "view == limeclient.actions && viewItem == actionJob",
                    "group": "inline"
                },
                {
                    "command": "limeclient.actions.viewRunLogs",
                    "when": "view == limeclient.actions && viewItem == actionRun",
                    "group": "1_logs"
                },
                {
                    "command": "limeclient.actions.addSecret",
                    "when": "view == limeclient.actionsSettings && viewItem == actionsSettingsRepo",
                    "group": "inline"
                },
                {
                    "command": "limeclient.actions.addVariable",
                    "when": "view == limeclient.actionsSettings && viewItem == actionsSettingsRepo",
                    "group": "1_actions"
                },
                {
                    "command": "limeclient.actions.addSecret",
                    "when": "view == limeclient.actionsSettings && viewItem == actionSettingsGroupSecrets",
                    "group": "inline"
                },
                {
                    "command": "limeclient.actions.addVariable",
                    "when": "view == limeclient.actionsSettings && viewItem == actionSettingsGroupVariables",
                    "group": "inline"
                },
                {
                    "command": "limeclient.actions.deleteSecret",
                    "when": "view == limeclient.actionsSettings && viewItem == actionSecret",
                    "group": "inline"
                },
                {
                    "command": "limeclient.actions.updateSecret",
                    "when": "view == limeclient.actionsSettings && viewItem == actionSecret",
                    "group": "1_actions"
                },
                {
                    "command": "limeclient.actions.updateVariable",
                    "when": "view == limeclient.actionsSettings && viewItem == actionVariable",
                    "group": "inline"
                },
                {
                    "command": "limeclient.actions.deleteVariable",
                    "when": "view == limeclient.actionsSettings && viewItem == actionVariable",
                    "group": "1_actions"
                },
                {
                    "command": "limeclient.openRepository",
                    "when": "view == limeclient.repositories && viewItem == repository",
                    "group": "inline"
                },
                {
                    "command": "limeclient.openInBrowser",
                    "when": "view == limeclient.repositories && viewItem == repository",
                    "group": "inline"
                },
                {
                    "command": "limeclient.openIssueInBrowser",
                    "when": "view == limeclient.issues && viewItem == issue",
                    "group": "inline"
                },
                {
                    "command": "limeclient.viewIssueDetails",
                    "when": "view == limeclient.issues && viewItem == issue",
                    "group": "inline"
                },
                {
                    "command": "limeclient.openPullRequestInBrowser",
                    "when": "view == limeclient.pullRequests && viewItem == pullRequest",
                    "group": "inline"
                },
                {
                    "command": "limeclient.viewPullRequestDetails",
                    "when": "view == limeclient.pullRequests && viewItem == pullRequest",
                    "group": "inline"
                },
                {
                    "command": "limeclient.createBranchFromIssue",
                    "when": "view == limeclient.issues && viewItem == issue",
                    "group": "1_branch"
                },
                {
                    "command": "limeclient.createBranchFromPR",
                    "when": "view == limeclient.pullRequests && viewItem == pullRequest",
                    "group": "1_branch"
                },
                {
                    "command": "limeclient.restoreBranchFromTree",
                    "when": "view == limeclient.deletedBranches && viewItem == deletedBranch",
                    "group": "inline"
                },
                {
                    "command": "limeclient.removeFromHistory",
                    "when": "view == limeclient.deletedBranches && viewItem == deletedBranch",
                    "group": "1_actions"
                }
            ]
        },
        "configuration": {
            "title": "LimeClient",
            "properties": {
                "limeclient.instanceUrl": {
                    "type": "string",
                    "default": "",
                    "description": "Your Gitea instance URL (e.g., https://gitea.example.com)"
                },
                "limeclient.authToken": {
                    "type": "string",
                    "default": "",
                    "description": "Personal Access Token for Gitea API authentication"
                },
                "limeclient.enableNotifications": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable notifications for repository activities"
                },
                "limeclient.notificationPollInterval": {
                    "type": "number",
                    "default": 60000,
                    "description": "Poll interval for notifications in milliseconds (minimum 30000 - 30 seconds)",
                    "minimum": 30000
                },
                "limeclient.defaultRepoStartingPath": {
                    "type": "string",
                    "default": "",
                    "description": "Default starting path for repository operations"
                },
                "limeclient.showAllReposWhenNoWorkspace": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show all repositories when none are detected in the current workspace"
                },
                "limeclient.repoScanDepth": {
                    "type": "number",
                    "default": 2,
                    "description": "Maximum folder depth to scan for git repositories in the workspace",
                    "minimum": 0,
                    "maximum": 6
                },
                "limeclient.profiles": {
                    "type": "object",
                    "default": {},
                    "description": "Configured Gitea profiles for multiple accounts",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "instanceUrl": {
                                "type": "string",
                                "description": "Gitea instance URL for this profile"
                            },
                            "authToken": {
                                "type": "string",
                                "description": "Personal Access Token for this profile (not stored for OAuth profiles)"
                            },
                            "authType": {
                                "type": "string",
                                "enum": [
                                    "token",
                                    "oauth",
                                    "gitcredential"
                                ],
                                "description": "Authentication method used by this profile"
                            }
                        },
                        "required": [
                            "instanceUrl"
                        ]
                    }
                },
                "limeclient.activeProfile": {
                    "type": "string",
                    "default": "default",
                    "description": "Name of the currently active Gitea profile"
                },
                "limeclient.oauthClientId": {
                    "type": "string",
                    "default": "",
                    "description": "Client ID of the OAuth2 application registered on your Gitea server (Settings → Applications → OAuth2 Applications)"
                },
                "limeclient.oauthClientSecret": {
                    "type": "string",
                    "default": "",
                    "description": "Optional client secret of your Gitea OAuth2 application. Not required when using PKCE"
                },
                "limeclient.oauthRedirectPort": {
                    "type": "number",
                    "default": 53123,
                    "description": "Local port used for the OAuth callback. Must match the redirect URI registered in your Gitea OAuth2 application: http://127.0.0.1:<port>/callback"
                },
                "limeclient.oauthScopes": {
                    "type": "string",
                    "default": "read:user read:repository write:repository write:issue read:issue write:pull_request read:pull_request read:organization",
                    "description": "Space-separated OAuth2 scopes requested from Gitea"
                },
                "limeclient.branchDeletionRetentionDays": {
                    "type": "number",
                    "default": 90,
                    "description": "Number of days to retain deleted branch history (default: 90 days)",
                    "minimum": 1,
                    "maximum": 365
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "compile": "tsc -p ./",
        "compile:tests": "tsc -p ./tsconfig.test.json",
        "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
        "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
        "lint": "eslint .",
        "pretest": "npm run lint && npm run compile:tests",
        "test": "vscode-test",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "^1.90.0",
        "@typescript-eslint/eslint-plugin": "^8.66.0",
        "@typescript-eslint/parser": "^8.66.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.1",
        "eslint": "^9.39.1",
        "typescript": "~5.9"
    },
    "dependencies": {
        "marked": "^12.0.0"
    }
}
